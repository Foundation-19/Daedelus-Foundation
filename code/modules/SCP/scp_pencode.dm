	t = replacetext(t, "\[i\]", "<I>")
	t = replacetext(t, "\[/i\]", "</I>")
	t = replacetext(t, "\[u\]", "<U>")
	t = replacetext(t, "\[/u\]", "</U>")
	t = replacetext(t, "\[time\]", "[gameTimestamp("hh:mm")]")
	t = replacetext(t, "\[date\]", "[time2text(world.timeofday, "YYYY-MM-DD")]")
	t = replacetext(t, "\[large\]", "<font size=\"4\">")
